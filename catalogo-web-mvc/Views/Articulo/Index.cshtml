@model X.PagedList.IPagedList<catalogo_web_mvc.Models.Articulo>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Grilla de Artículos";
}

<h1>Grilla de Artículos</h1>



<!-- Mensaje de validación -->
@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    <div class="alert alert-warning">@ViewBag.Mensaje</div>
}

<!-- Formulario de búsqueda y filtros -->
<form asp-action="Index" method="get">
    <div class="row">
        <!-- Buscador simple -->
        <div class="col-6">
            <div class="mb-3">
                <label for="searchString">Buscar por nombre</label>
                <input type="text" id="searchString" name="searchString" class="form-control"
                       value="@Context.Request.Query["searchString"]" />
            </div>
        </div>

        <!-- Checkbox filtro avanzado -->
        <div class="col-6 d-flex flex-column justify-content-end">
            <div class="mb-3 form-check">
                <input type="checkbox" id="filtroAvanzado" name="filtroAvanzado" class="form-check-input"
                @(Context.Request.Query["filtroAvanzado"] == "true" ? "checked" : "") />
                <label class="form-check-label" for="filtroAvanzado">Filtro Avanzado</label>
            </div>
        </div>
    </div>

    <!-- Bloque de filtros avanzados -->
    <div id="filtrosAvanzados" style="display:@(Context.Request.Query["filtroAvanzado"] == "true" ? "block" : "none");">
        <div class="row">
            <div class="col-3">
                <label for="campo">Campo</label>
                <select id="campo" name="campo" class="form-control">
                    <option value="Codigo">Código</option>
                    <option value="Nombre">Nombre</option>
                    <option value="Precio">Precio</option>
                    <option value="Marca">Marca</option>
                    <option value="Categoria">Categoría</option>
                </select>
            </div>
            <div class="col-3">
                <label for="criterio">Criterio</label>
                <select id="criterio" name="criterio" class="form-control">
                    <option value="Contiene">Contiene</option>
                    <option value="Comienza con">Comienza con</option>
                    <option value="Termina con">Termina con</option>
                    <option value="Igual a">Igual a</option>
                    <option value="Mayor a">Mayor a</option>
                    <option value="Menor a">Menor a</option>
                </select>
            </div>
            <div class="col-3">
                <label for="filtro">Filtro</label>
                <input type="text" id="filtro" name="filtro" class="form-control"
                       value="@Context.Request.Query["filtro"]" />
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-3">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Limpiar filtros</a>
            </div>
        </div>
    </div>
</form>

<hr />

<!-- Tabla de artículos -->
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model[0].Codigo)</th>
            <th>@Html.DisplayNameFor(model => model[0].Nombre)</th>
            <th>@Html.DisplayNameFor(model => model[0].Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model[0].Marca)</th>
            <th>@Html.DisplayNameFor(model => model[0].Categoria)</th>
            
            <th class="text-end">@Html.DisplayNameFor(model => model[0].Precio)</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Marca?.Descripcion</td>
                    <td>@item.Categoria?.Descripcion</td>
                    
                    <td class="text-end">@String.Format("{0:N2}", item.Precio)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <span class="me-2">⚠️</span>
                        <span>No se encontraron artículos con ese criterio.</span>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Paginador -->
<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5,
            UlElementClasses = new[] { "pagination" }
        })
</div>
<!-- Botón nuevo artículo -->
<p>
    <a asp-action="Create"  class="btn btn-secondary">Nuevo artículo</a>
</p>

