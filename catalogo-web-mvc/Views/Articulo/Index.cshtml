@model X.PagedList.IPagedList<catalogo_web_mvc.Models.Articulo>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Grilla de Artículos";
}

<h1>Grilla de Artículos</h1>



<!-- Mensaje de validación -->
@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    <div class="alert alert-warning">@ViewBag.Mensaje</div>
}

<!-- Formulario de búsqueda y filtros -->
<form asp-action="Index" method="get">
    <div class="row mb-3">
        <!-- Buscador simple -->
        <div class="col-6">
            <div class="mb-3">
                
                <label for="searchString">Buscar por nombre</label>
                
                <input type="text" id="searchString" name="searchString" class="form-control"
                       value="@Context.Request.Query["searchString"]" />
            </div>
        </div>
       
        <!-- Checkbox al lado derecho -->
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="filtroAvanzado" name="filtroAvanzado" value="true"
                @(Context.Request.Query["filtroAvanzado"] == "true" || Context.Request.Query["filtroAvanzado"] == "on" ? "checked" : "") />
                <label class="form-check-label" for="filtroAvanzado">Filtro Avanzado</label>
            </div>
        </div>
        
        <div id="camposAvanzados" class="row mb-3" style="display:@(Context.Request.Query["filtroAvanzado"] == "true" || Context.Request.Query["filtroAvanzado"] == "on" ? "flex" : "none")">
            <div class="col-md-3">
                <label>Campo</label>
                <select name="campo" class="form-control">
                    <option value="Codigo" selected="@(Context.Request.Query["campo"] == "Codigo")">Código</option>
                    <option value="Nombre" selected="@(Context.Request.Query["campo"] == "Nombre")">Nombre</option>
                    <option value="Precio" selected="@(Context.Request.Query["campo"] == "Precio")">Precio</option>
                    <option value="Marca" selected="@(Context.Request.Query["campo"] == "Marca")">Marca</option>
                    <option value="Categoria" selected="@(Context.Request.Query["campo"] == "Categoria")">Categoría</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Criterio</label>
                <select name="criterio" class="form-control">

                    @if (Context.Request.Query["campo"] == "Precio")
                    {
                        <option value="Igual a" selected="@(Context.Request.Query["criterio"] == "Igual a")">Igual a</option>
                        <option value="Mayor a" selected="@(Context.Request.Query["criterio"] == "Mayor a")">Mayor a</option>
                        <option value="Menor a" selected="@(Context.Request.Query["criterio"] == "Menor a")">Menor a</option>
                    }
                    else
                    {
                        <option value="Contiene" selected="@(Context.Request.Query["criterio"] == "Contiene")">Contiene</option>
                        <option value="Comienza con" selected="@(Context.Request.Query["criterio"] == "Comienza con")">Comienza con</option>
                        <option value="Termina con" selected="@(Context.Request.Query["criterio"] == "Termina con")">Termina con</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label>Filtro</label>
                <input type="text" name="filtro" class="form-control"  autocomplete="off" value="@Context.Request.Query["filtro"]" />
        
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
        </div>
        
        @section Scripts {
            <script src="~/js/articulo-index.js">

            </script>
        }
    </div>
</form>
        
<!-- Tabla de artículos -->
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model[0].Codigo)</th>
            <th>@Html.DisplayNameFor(model => model[0].Nombre)</th>
            <th>@Html.DisplayNameFor(model => model[0].Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model[0].Marca)</th>
            <th>@Html.DisplayNameFor(model => model[0].Categoria)</th>
            
            <th class="text-end">@Html.DisplayNameFor(model => model[0].Precio)</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Marca?.Descripcion</td>
                    <td>@item.Categoria?.Descripcion</td>
                    
                    <td class="text-end">@String.Format("{0:N2}", item.Precio)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <span class="me-2">⚠️</span>
                        <span>No se encontraron artículos con ese criterio.</span>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Paginador -->
<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5,
            UlElementClasses = new[] { "pagination" }
        })
</div>
<!-- Botón nuevo artículo -->
<p>
    <a asp-action="Create" class="btn btn-secondary">Nuevo artículo</a>
</p>

