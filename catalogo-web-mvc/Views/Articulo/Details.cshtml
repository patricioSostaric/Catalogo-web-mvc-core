@model catalogo_web_mvc.Models.Articulo

@{
    ViewData["Title"] = "Detalles del artículo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Tarjeta principal -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4">
                    <h2 class="text-primary fw-bold">@ViewData["Title"]</h2>
                </div>

                <div class="card-body px-4">
                    
                    @await Html.PartialAsync("_ArticuloDetalle", Model)
                </div>

                <div class="card-footer bg-white border-top-0 pb-4 px-4">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Volver al listado
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>