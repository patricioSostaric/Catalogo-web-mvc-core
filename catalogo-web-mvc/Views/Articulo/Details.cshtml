@model catalogo_web_mvc.Models.Articulo

@{
    ViewData["Title"] = "Detalles";
}


<h1>Detalles del artículo</h1>
<hr />

@await Html.PartialAsync("_ArticuloDetalle", Model)

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Volver al listado</a>
</div>

