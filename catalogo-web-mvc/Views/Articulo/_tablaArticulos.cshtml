@model X.PagedList.IPagedList<catalogo_web_mvc.Models.Articulo>
<div class="table-responsive shadow-sm rounded">
<table class="table table-hover align-middle mb-0">
    <!-- Cabecera oscura y sofisticada -->
    <thead class="table-dark">
        <tr>
            <th class="ps-4 d-none d-md-table-cell">@Html.DisplayNameFor(m => m[0].Codigo)</th>
            <th class="ps-4 ps-md-0">@Html.DisplayNameFor(m => m[0].Nombre)</th>
            <th class="d-none d-md-table-cell">@Html.DisplayNameFor(m => m[0].Descripcion)</th>
            <th>@Html.DisplayNameFor(m => m[0].Marca)</th>
            <th class="d-none d-md-table-cell">@Html.DisplayNameFor(m => m[0].Categoria)</th>
            <th class="text-end">@Html.DisplayNameFor(m => m[0].Precio)</th>
                <th class="text-end d-none d-md-table-cell">@Html.DisplayNameFor(m => m[0].Stock)</th>
                <th class="text-center d-none d-md-table-cell">@Html.DisplayNameFor(m => m[0].Activo)</th>
            <th class="text-center pe-4">Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <!-- Código con estilo secundario destacado -->
                    <td class="ps-4 fw-semibold text-secondary d-none d-md-table-cell">@item.Codigo</td>

                    <!-- Nombre del producto resaltado -->
                    <td class="fw-bold text-dark ps-4 ps-md-0">@item.Nombre</td>

                    <!-- Descripción truncada para que textos muy largos no rompan la grilla -->
                    <td class="text-muted text-truncate d-none d-md-table-cell" style="max-width: 220px;">@item.Descripcion</td>

                    <!-- Etiquetas limpias para Marca y Categoría -->
                    <td><span class="badge bg-light text-dark border fw-normal px-2 py-1">@item.Marca?.Descripcion</span></td>
                    <td class="d-none d-md-table-cell"><span class="badge bg-light text-dark border fw-normal px-2 py-1">@item.Categoria?.Descripcion</span></td>

                    <td class="text-end fw-bold text-dark">$ @String.Format("{0:N2}", item.Precio)</td>
                    <td class="text-end text-secondary d-none d-md-table-cell">@item.Stock</td>

                    <!-- Badges de estado modernos con colores suaves -->
                    <td class="text-center d-none d-md-table-cell">
                        @if (item.Activo)
                        {
                            <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">No</span>
                        }
                    </td>

                    <!-- Grupo de botones unificado como herramienta de control -->
                    <td class="text-center pe-4">
                        <div class="btn-group btn-group-sm text-nowrap" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary fw-medium px-2" aria-label="Editar">
                                <i class="bi bi-pencil d-md-none"></i>
                                <span class="d-none d-md-inline">Editar</span>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary fw-medium px-2" aria-label="Detalles">
                                <i class="bi bi-eye d-md-none"></i>
                                <span class="d-none d-md-inline">Detalles</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger fw-medium px-2" aria-label="Eliminar">
                                <i class="bi bi-trash d-md-none"></i>
                                <span class="d-none d-md-inline">Eliminar</span>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="p-4">
                    <div class="alert alert-danger d-flex align-items-center m-0 rounded-3 shadow-sm" role="alert">
                        <span class="me-2">⚠️</span>
                        <span>No se encontraron artículos con ese criterio.</span>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>