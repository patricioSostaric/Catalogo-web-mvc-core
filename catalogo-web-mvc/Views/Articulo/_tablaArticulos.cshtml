@model X.PagedList.IPagedList<catalogo_web_mvc.Models.Articulo>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m[0].Codigo)</th>
            <th>@Html.DisplayNameFor(m => m[0].Nombre)</th>
            <th>@Html.DisplayNameFor(m => m[0].Descripcion)</th>
            <th>@Html.DisplayNameFor(m => m[0].Marca)</th>
            <th>@Html.DisplayNameFor(m => m[0].Categoria)</th>
            <th class="text-end">@Html.DisplayNameFor(m => m[0].Precio)</th>
            <th>@Html.DisplayNameFor(m =>m[0].Stock)</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Marca?.Descripcion</td>
                    <td>@item.Categoria?.Descripcion</td>
                    <td class="text-end">@String.Format("{0:N2}", item.Precio)</td>
                        <td>@item.Stock</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <span class="me-2">⚠️</span>
                        <span>No se encontraron artículos con ese criterio.</span>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

