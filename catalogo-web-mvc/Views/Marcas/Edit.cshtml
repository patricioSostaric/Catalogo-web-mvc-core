@model Marca

@{
    ViewData["Title"] = "Edit";
    var vm = new DescripcionFormViewModel
    {
        Id = Model.MarcaId,
        IdFieldName = "MarcaId",
        NombreEntidad = "Marca",
        Accion = "Editar",
        FormAction = "Edit",
        SubmitText = "Guardar",
        VolverTexto = "Volver a la lista de Marcas",
        Descripcion = Model.Descripcion
    };
}



<partial name="_FormularioDescripcion" model="vm" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
