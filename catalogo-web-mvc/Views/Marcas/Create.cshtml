@model Marca

@{
    ViewData["Title"] = "Create";
    var vm = new DescripcionFormViewModel
    {
        NombreEntidad = "Marca",
        Accion = "Crear",
        FormAction = "Create",
        SubmitText = "Crear",
        VolverTexto = "Volver a la lista de Marcas",
        Descripcion = Model?.Descripcion ?? ""
    };
}

<partial name="_FormularioDescripcion" model="vm" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
