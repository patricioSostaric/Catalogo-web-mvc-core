@model X.PagedList.IPagedList<Marca>

@{
    ViewData["Title"] = "gestion de marcas";
    var vm = new TablaEntidadViewModel
    {
        NombreEntidad = "Marca",
        Columnas = new List<string> { "Descripción" },
        Filas = Model.Select(m => new FilaTabla
        {
            Id = m.MarcaId,
            Valores = new List<string> { m.Descripcion }
        }).ToList()
    };
}

<div class="container my-5">

    <!-- HEADER DEL DASHBOARD (Misma alineación simétrica) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark h2 mb-1">Grilla de Marcas</h1>
            <p class="text-muted small m-0">Panel de administración de fabricantes y marcas.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <!-- Botón verde de nueva marca arriba a la derecha -->
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 fw-medium shadow-sm text-decoration-none">
                + Nueva marca
            </a>
        </div>
    </div>

    <!-- TARJETA CONTENEDORA DE LA TABLA GENÉRICA -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <partial name="_TablaEntidad" model="vm" />
    </div>

    <!-- PAGINADO CENTRADO -->
    <div class="d-flex justify-content-center mt-4">

        @await Html.PartialAsync("_Paginado", Model)

    </div>
</div>