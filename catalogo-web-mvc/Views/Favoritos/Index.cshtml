@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<catalogo_web_mvc.Models.ViewModels.FavoritoViewModel>
@{
    ViewData["Title"] = "Mis Favoritos";
}

<h2>⭐ Mis Favoritos</h2>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="gold" viewBox="0 0 16 16">
            <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696 2.188-4.304c.197-.39.73-.39.927 0l2.188 4.304 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
        </svg>
        <p class="mt-3 text-muted">No tenés artículos en favoritos todavía.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ver artículos</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var fav in Model)
        {
            <div class="col">
                <div class="card h-100 card-unificada">
                    <img src="@fav.ImagenUrl"
                         class="img-fluid rounded detalle-img"
                         alt="@fav.Nombre"
                         onerror="this.src='/img/sin-imagen.png'" />
                    <div class="card-body">
                        <span class="card-title h5 d-block">@fav.Nombre</span>
                        <span class="card-text descripcion d-block">@fav.Descripcion</span>
                        <span class="card-text d-block fw-semibold">$@fav.Precio.ToString("N2")</span>
                        <div class="mt-2">
                            <form asp-controller="Favoritos" asp-action="Remove" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@fav.ArticuloId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">❌ Quitar</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.PageCount > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page })!)
        </div>
    }
}
