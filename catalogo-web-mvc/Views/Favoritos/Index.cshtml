@model X.PagedList.IPagedList<catalogo_web_mvc.Models.ViewModels.FavoritoViewModel>
@{
    ViewData["Title"] = "Mis Favoritos";
}

<h2 class="CentrarTitulo mb-4">Mis artículos favoritos</h2>

@if (!Model.Any() && Model.PageNumber == 1)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="card shadow-sm p-4 text-center d-flex flex-column align-items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="40" height="40" fill="gold">
                <polygon points="12 2 15 9 22 9 17 14 19 21 12 17 5 21 7 14 2 9 9 9"/>
            </svg>
            <p class="text-muted fs-5 mb-0">No tenés artículos favoritos.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">Ver catálogo</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 card-unificada">
                    <img src="@item.ImagenUrl"
                         class="img-fluid rounded detalle-img"
                         alt="Imagen del artículo"
                         onerror="this.src='https://www.mansor.com.uy/wp-content/uploads/2020/06/imagen-no-disponible2.jpg'" />
                    <div class="card-body">
                        <span class="card-title h5 d-block">@item.Nombre</span>
                        <span class="card-text descripcion d-block">@item.Descripcion</span>
                        <span class="card-text d-block fw-semibold">Precio: $@item.Precio.ToString("N2")</span>

                        <div class="mt-2 d-flex flex-wrap gap-1">
                            <a asp-controller="Home" asp-action="Detalle" asp-route-id="@item.ArticuloId"
                               class="btn btn-outline-primary btn-sm">Ver detalle</a>

                            <button type="button" class="btn btn-secondary btn-sm"
                                    disabled title="Disponible próximamente">Comprar</button>

                            <form asp-controller="Favoritos" asp-action="Remove"
                                  asp-route-id="@item.ArticuloId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-warning">
                                    ⭐ Quitar de favoritos
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Paginado", Model)
}
