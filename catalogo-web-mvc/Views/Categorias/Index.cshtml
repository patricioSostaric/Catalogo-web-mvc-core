@model X.PagedList.IPagedList<Categoria>

@{
    ViewData["Title"] = "gestion categorias";
    var vm = new TablaEntidadViewModel
    {
        NombreEntidad = "Categoría",
        Columnas = new List<string> { "Descripción" },
        Filas = Model.Select(c => new FilaTabla
        {
            Id = c.CategoriaId,
            Valores = new List<string> { c.Descripcion }
        }).ToList()
    };
}

<div class="container my-5">

    <!-- HEADER DEL DASHBOARD: Título estilizado y Botón Principal Arriba a la Derecha -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark h2 mb-1">Lista de Categorías</h1>
            <p class="text-muted small m-0">Administración general de las clasificaciones del catálogo.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <!-- Movimos el botón acá arriba con estilo success -->
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 fw-medium shadow-sm text-decoration-none">
                + Crear categoría
            </a>
        </div>
    </div>
    <!-- TABLA CONTENIDA EN LA TARJETA BLANCA CON SOMBRA -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <partial name="_TablaEntidad" model="vm" />
    </div>
    <div class="d-flex justify-content-center mt-4">
        @await Html.PartialAsync("_Paginado", Model)
    </div>
</div>