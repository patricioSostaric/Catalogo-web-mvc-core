@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "categorias";
    var vm = new TablaEntidadViewModel
    {
        NombreEntidad = "Categoría",
        Columnas = new List<string> { "Descripción" },
        Filas = Model.Select(c => new FilaTabla
        {
            Id = c.CategoriaId,
            Valores = new List<string> { c.Descripcion }
        }).ToList()
    };
}

<h1>categorias</h1>

<p>
    <a asp-action="Create">Crear categoria</a>
</p>

<partial name="_TablaEntidad" model="vm" />
