@model Categoria

@{
    ViewData["Title"] = "modificar";
    var vm = new DescripcionFormViewModel
    {
        Id = Model.CategoriaId,
        IdFieldName = "CategoriaId",
        NombreEntidad = "Categoria",
        Accion = "Editar",
        FormAction = "Edit",
        SubmitText = "Guardar",
        VolverTexto = "Volver a la lista de categorias",
        Descripcion = Model.Descripcion
    };
}

<partial name="_FormularioDescripcion" model="vm" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
