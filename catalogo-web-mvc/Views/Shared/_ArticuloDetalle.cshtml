@model catalogo_web_mvc.Models.Articulo

<div class="row align-items-center">
    <!-- Información -->
    <div class="col-md-7">
        <dl class="row mb-0">
            @* Usamos una clase de utilidad para darle un poco más de separación *@
            <div class="col-12 mb-2 pb-2 border-bottom">
                <dt class="text-muted small">@Html.DisplayNameFor(model => model.Codigo)</dt>
                <dd class="fw-bold fs-5 mb-0">@Html.DisplayFor(model => model.Codigo)</dd>
            </div>

            <div class="col-12 mb-2 pb-2 border-bottom">
                <dt class="text-muted small">@Html.DisplayNameFor(model => model.Nombre)</dt>
                <dd class="fs-5 mb-0">@Html.DisplayFor(model => model.Nombre)</dd>
            </div>

            <div class="col-12 mb-2 pb-2 border-bottom">
                <dt class="text-muted small">@Html.DisplayNameFor(model => model.Descripcion)</dt>
                <dd class="text-secondary">@Html.DisplayFor(model => model.Descripcion)</dd>
            </div>

            <!-- Fila doble para datos técnicos -->
            <div class="col-6 mb-2">
                <dt class="text-muted small">@Html.DisplayNameFor(model => model.Precio)</dt>
                <dd class="fw-bold text-primary">@String.Format("{0:C2}", Model.Precio)</dd>
            </div>
            <div class="col-6 mb-2">
                <dt class="text-muted small">@Html.DisplayNameFor(model => model.Stock)</dt>
                <dd>@Model.Stock unidades</dd>
            </div>
        </dl>
    </div>

    <!-- Imagen -->
    <div class="col-md-5 text-center">
        <div class="p-2 border rounded shadow-sm bg-light">
            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl"
                     class="img-fluid rounded"
                     style="max-height: 250px; object-fit: contain;"
                     alt="@Model.Nombre"
                     onerror="this.src='https://www.mansor.com.uy/wp-content/uploads/2020/06/imagen-no-disponible2.jpg'" />
            }
            else
            {
                <div class="p-5 text-muted">Imagen no disponible</div>
            }
        </div>
    </div>
</div>
