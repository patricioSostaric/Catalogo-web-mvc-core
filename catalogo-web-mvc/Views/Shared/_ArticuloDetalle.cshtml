@model catalogo_web_mvc.Models.Articulo

<div class="row">
    <div class="col-md-7">
        <dl class="row">
            <dt class="col-sm-4">Código</dt>
            <dd class="col-sm-8">@Model.Codigo</dd>

            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Descripción</dt>
            <dd class="col-sm-8">@Model.Descripcion</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">$@Model.Precio.ToString("N2")</dd>

            <dt class="col-sm-4">Marca</dt>
            <dd class="col-sm-8">@Model.Marca?.Descripcion</dd>

            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Model.Categoria?.Descripcion</dd>
        </dl>
    </div>
    <div class="col-md-5 text-center">
        <img src="@Model.ImagenUrl"
             class="img-fluid rounded detalle-img"
             alt="Imagen del artículo"
             onerror="this.src='/img/sin-imagen.png'" />
    </div>
</div>
