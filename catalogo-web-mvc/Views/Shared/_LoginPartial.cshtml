@using catalogo_web_mvc.Services.Avatar
@using catalogo_web_mvc.Services.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<catalogo_web_mvc.Models.ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    @* El avatar y el nombre salen de los claims de la cookie (los agrega
       ApplicationUserClaimsPrincipalFactory), así que el navbar no consulta la base.
       El fallback cubre las sesiones abiertas antes de que existiera el claim. *@
    var avatar = User.FindFirst(ApplicationUserClaimsPrincipalFactory.ClaimAvatar)?.Value
                 ?? AvatarUrlValidator.RutaPorDefecto;
    var nombre = User.FindFirst(ApplicationUserClaimsPrincipalFactory.ClaimNombreParaMostrar)?.Value
                 ?? User.Identity?.Name
                 ?? "Mi perfil";

    <li class="nav-item">
        <a class="nav-link text-dark d-flex align-items-center gap-2 py-1"
           asp-controller="Account" asp-action="Perfil" title="Ver mi perfil">
            <img src="@avatar" alt="Imagen de perfil de @nombre" class="avatar" data-avatar-fallback />
            <span class="d-none d-sm-inline">@nombre</span>
        </a>
    </li>

    <li class="nav-item d-flex align-items-center">
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-link nav-link text-dark px-0">
                Cerrar sesión
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Ingresar</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Registrarse</a>
    </li>
}
