@model catalogo_web_mvc.Models.ViewModels.ArticuloDetalleViewModel

@{
    ViewData["Title"] = Model.Nombre;
}

<h1>Detalles del artículo</h1>
<hr />

@await Html.PartialAsync("_ArticuloDetallePublico", Model)

@{
    bool esFavorito = ViewBag.EsFavorito as bool? ?? false;
}

<div class="mt-3">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Favoritos" asp-action="@(esFavorito ? "Remove" : "Add")"
              asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn @(esFavorito ? "btn-warning" : "btn-outline-warning")">
                @(esFavorito ? "⭐ Quitar de favoritos" : "♡ Agregar a favoritos")
            </button>
        </form>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Volver al catálogo</a>
</div>
