@model catalogo_web_mvc.Models.Articulo

@{
    ViewData["Title"] = Model.Nombre;
}

<h1>Detalles del artículo</h1>
<hr />

@await Html.PartialAsync("_ArticuloDetalle", Model)

<div class="mt-3">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Favoritos" asp-action="Add"
              asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-warning">⭐ Agregar a favoritos</button>
        </form>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Volver al catálogo</a>
</div>
