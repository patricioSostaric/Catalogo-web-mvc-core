@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<catalogo_web_mvc.Models.Articulo>
@{
    ViewData["Title"] = "Inicio";
    var favoritos = ViewBag.Favoritos as HashSet<int> ?? new HashSet<int>();
}

<h1 class="CentrarTitulo">¡Bienvenido/a!</h1>
<p>Te encontrás en la web de artículos.</p>
<h3>Lista de Artículos</h3>

<form asp-action="Index" method="get">
    <div class="row mb-3">
        @await Html.PartialAsync("_filtroComun")
    </div>
</form>

@if (ViewBag.Mensaje != null)
{
    <div class="mb-3">
        <span class="text-danger">@ViewBag.Mensaje</span>
    </div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var articulo in Model)
    {
        bool esFavorito = favoritos.Contains(articulo.Id);
        <div class="col">
            <div class="card h-100 card-unificada">
                <img src="@articulo.ImagenUrl"
                     class="img-fluid rounded detalle-img"
                     alt="Imagen del artículo"
                     onerror="this.src='/img/sin-imagen.png'" />
                <div class="card-body">
                    <span class="card-title h5 d-block">@articulo.Nombre</span>
                    <span class="card-text descripcion d-block">@articulo.Descripcion</span>
                    <span class="card-text d-block fw-semibold">$@articulo.Precio.ToString("N2")</span>
                    <div class="mt-2">
                        <a asp-controller="Home" asp-action="Detalle" asp-route-id="@articulo.Id"
                           class="btn btn-outline-primary btn-sm">Ver detalle</a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (esFavorito)
                            {
                                <form asp-controller="Favoritos" asp-action="Remove" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@articulo.Id" />
                                    <button type="submit" class="btn btn-warning btn-sm mt-1 ms-1">⭐ Quitar</button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Favoritos" asp-action="Add" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@articulo.Id" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm mt-1 ms-1">♡ Favorito</button>
                                </form>
                            }
                        }

                        <button type="button" class="btn btn-secondary btn-sm mt-1"
                                disabled title="Próximamente">Comprar</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.PageCount > 1)
{
    <div class="d-flex justify-content-center mt-4">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = Context.Request.Query["searchString"] })!)
    </div>
}
