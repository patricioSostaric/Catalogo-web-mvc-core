@model catalogo_web_mvc.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    ViewData["Titulo"] = "¿Olvidaste tu contraseña?";
    ViewData["Subtitulo"] = "Ingresá tu email y te enviamos instrucciones";
    ViewData["FormPartial"] = "_ForgotPasswordForm";
    ViewData["FooterAction"] = "Login";
    ViewData["FooterTexto"] = "Volver a iniciar sesión";
}

@await Html.PartialAsync("_AuthCard", Model)

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
