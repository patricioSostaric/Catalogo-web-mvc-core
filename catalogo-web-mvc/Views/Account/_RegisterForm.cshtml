@model catalogo_web_mvc.Models.ViewModels.RegisterViewModel

@* enctype multipart es obligatorio para que el archivo llegue al servidor;
   sin esto el input file se envía solo como nombre y el IFormFile queda null *@
<form asp-action="Register" method="post" enctype="multipart/form-data">

    <!-- Resumen de errores de validación -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small alert alert-danger p-2"></div>

    <!-- Campo Email -->
    <div class="mb-3">
        <label asp-for="Email" class="form-label text-secondary small fw-medium">Email</label>
        <input asp-for="Email" class="form-control rounded-3" placeholder="ejemplo@correo.com" />
        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
    </div>

    <!-- Campo Password -->
    <div class="mb-3">
        <label asp-for="Password" class="form-label text-secondary small fw-medium">Contraseña</label>
        <div class="input-group">
            <input asp-for="Password" class="form-control rounded-start-3" placeholder="••••••••" />
            @await Html.PartialAsync("_PasswordToggleButton", "Password")
        </div>
        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
    </div>

    <!-- Campo Confirmar Password -->
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label text-secondary small fw-medium">Confirmar contraseña</label>
        <div class="input-group">
            <input asp-for="ConfirmPassword" class="form-control rounded-start-3" placeholder="••••••••" />
            @await Html.PartialAsync("_PasswordToggleButton", "ConfirmPassword")
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
    </div>

    <!-- Datos de perfil e imagen: mismo partial que usa la pantalla de perfil -->
    <hr class="my-4" />
    <p class="text-secondary small fw-medium mb-3">Tus datos</p>

    @* El prefijo hace que los inputs se llamen "Datos.Nombre" y bindeen a la
       propiedad anidada del RegisterViewModel *@
    @await Html.PartialAsync("_CamposPerfil", Model.Datos, new ViewDataDictionary(ViewData)
    {
        TemplateInfo = { HtmlFieldPrefix = nameof(Model.Datos) }
    })

    <div class="mb-4"></div>

    <!-- Botón Registrarse (Estilo bloque) -->
    <div class="d-grid">
        <button type="submit" class="btn btn-primary py-2 rounded-3 fw-medium shadow-sm">
            Registrarse
        </button>
    </div>
</form>
