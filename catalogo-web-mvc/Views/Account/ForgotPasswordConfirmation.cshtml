@{
    ViewData["Title"] = "Revisá tu correo";
}

<div class="container py-4">
    <div class="row justify-content-center align-items-center" style="min-height: 65vh;">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="card-body text-center">
                    <h2 class="fw-bold text-dark h3 mb-3">Revisá tu correo</h2>
                    <p class="text-muted small mb-4">
                        Si el email ingresado está registrado en el sistema, te enviamos un correo con instrucciones para restablecer tu contraseña.
                    </p>
                    <a asp-action="Login" class="btn btn-primary py-2 rounded-3 fw-medium shadow-sm d-block">
                        Volver a iniciar sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
