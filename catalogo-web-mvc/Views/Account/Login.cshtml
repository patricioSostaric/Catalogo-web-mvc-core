@model catalogo_web_mvc.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container py-4">
    <!-- Centra horizontal y verticalmente en la pantalla -->
    <div class="row justify-content-center align-items-center" style="min-height: 65vh;">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">

            <!-- Tarjeta contenedora idéntica al estilo limpio de la Home -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="card-body">

                    <!-- Cabecera de la tarjeta -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-dark h3 mb-1">Iniciar sesión</h2>
                        <p class="text-muted small m-0">Ingresá tus credenciales para continuar</p>
                    </div>

                    <!-- Formulario con tus rutas originales -->
                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                        <!-- Resumen de errores de validación de ASP.NET -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small alert alert-danger p-2"></div>

                        <!-- Campo Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-secondary small fw-medium">Email</label>
                            <input asp-for="Email" class="form-control rounded-3" placeholder="ejemplo@correo.com" />
                            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Campo Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-secondary small fw-medium">Contraseña</label>
                            <input asp-for="Password" class="form-control rounded-3" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Checkbox Recordarme -->
                        <div class="mb-4 form-check d-flex align-items-center">
                            <input asp-for="RememberMe" class="form-check-input mt-0 me-2" />
                            <label asp-for="RememberMe" class="form-check-label text-secondary small"></label>
                        </div>

                        <!-- Botón Ingresar (Estilo bloque moderno) -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2 rounded-3 fw-medium shadow-sm">
                                Ingresar
                            </button>
                        </div>
                    </form>

                    <!-- Enlace de registro separado por una línea sutil -->
                    <div class="mt-4 text-center border-top pt-3">
                        <a asp-action="Register" class="text-primary fw-medium text-decoration-none small">
                            ¿No tenés cuenta? Registrate
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
