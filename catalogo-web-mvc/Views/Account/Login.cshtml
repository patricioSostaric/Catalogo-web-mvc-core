@model catalogo_web_mvc.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["Titulo"] = "Iniciar sesión";
    ViewData["Subtitulo"] = "Ingresá tus credenciales para continuar";
    ViewData["FormPartial"] = "_LoginForm";
    ViewData["FooterAction"] = "Register";
    ViewData["FooterTexto"] = "¿No tenés cuenta? Registrate";
}

@await Html.PartialAsync("_AuthCard", Model)

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
