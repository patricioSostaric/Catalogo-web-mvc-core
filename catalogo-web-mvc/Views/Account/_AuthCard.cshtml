@{
    var titulo = ViewData["Titulo"] as string;
    var subtitulo = ViewData["Subtitulo"] as string;
    var formPartial = ViewData["FormPartial"] as string;
    var footerAction = ViewData["FooterAction"] as string;
    var footerTexto = ViewData["FooterTexto"] as string;

    // El registro necesita más ancho que el login porque suma los campos de perfil.
    var anchoColumnas = ViewData["Ancho"] as string ?? "col-12 col-sm-10 col-md-6 col-lg-4";
}

<div class="container py-4">
    <!-- Centra horizontal y verticalmente en la pantalla -->
    <div class="row justify-content-center align-items-center" style="min-height: 65vh;">
        <div class="@anchoColumnas">

            <!-- Tarjeta contenedora compartida por Login y Register -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="card-body">

                    <!-- Cabecera de la tarjeta -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-dark h3 mb-1">@titulo</h2>
                        <p class="text-muted small m-0">@subtitulo</p>
                    </div>

                    <!-- Formulario específico de cada vista -->
                    @await Html.PartialAsync(formPartial, (object)Model)

                    <!-- Enlace de navegación separado por una línea sutil -->
                    <div class="mt-4 text-center border-top pt-3">
                        <a asp-action="@footerAction" class="text-primary fw-medium text-decoration-none small">
                            @footerTexto
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
