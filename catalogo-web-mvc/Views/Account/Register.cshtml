@model catalogo_web_mvc.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registrarse";
}


<div class="container py-4">
    <!-- Centra horizontal y verticalmente en la pantalla -->
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">

            <!-- Tarjeta contenedora idéntica a la de Iniciar Sesión -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="card-body">

                    <!-- Cabecera de la tarjeta -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-dark h3 mb-1">Crear cuenta</h2>
                        <p class="text-muted small m-0">Completá tus datos para registrarte</p>
                    </div>

                    <!-- Formulario con tu ruta original -->
                    <form asp-action="Register" method="post">

                        <!-- Resumen de errores de validación -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small alert alert-danger p-2"></div>

                        <!-- Campo Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-secondary small fw-medium">Email</label>
                            <input asp-for="Email" class="form-control rounded-3" placeholder="ejemplo@correo.com" />
                            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Campo Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-secondary small fw-medium">Contraseña</label>
                            <input asp-for="Password" class="form-control rounded-3" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Campo Confirmar Password -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label text-secondary small fw-medium">Confirmar contraseña</label>
                            <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Botón Registrarse (Estilo bloque) -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2 rounded-3 fw-medium shadow-sm">
                                Registrarse
                            </button>
                        </div>
                    </form>

                    <!-- Enlace para volver al Login -->
                    <div class="mt-4 text-center border-top pt-3">
                        <a asp-action="Login" class="text-primary fw-medium text-decoration-none small">
                            ¿Ya tenés cuenta? Iniciá sesión
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
