@model catalogo_web_mvc.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registrarse";
    ViewData["Titulo"] = "Crear cuenta";
    ViewData["Subtitulo"] = "Completá tus datos para registrarte";
    ViewData["FormPartial"] = "_RegisterForm";
    ViewData["Ancho"] = "col-12 col-sm-11 col-md-9 col-lg-7";
    ViewData["FooterAction"] = "Login";
    ViewData["FooterTexto"] = "¿Ya tenés cuenta? Iniciá sesión";
}

@await Html.PartialAsync("_AuthCard", Model)

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
