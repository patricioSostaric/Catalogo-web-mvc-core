# Copiar a .env y completar con valores reales. El archivo .env NO se versiona.
#
#   cp .env.example .env

# Contraseña del usuario sa de SQL Server.
# Requiere 8+ caracteres con mayúscula, minúscula, dígito y símbolo.
MSSQL_SA_PASSWORD=

# Credenciales SMTP para los mails de bienvenida y recuperación de contraseña.
# Con Gmail hay que usar una contraseña de aplicación, no la del correo.
SMTP_USER=
SMTP_PASSWORD=

# Contraseña del usuario admin@catalogo.com en el entorno publicado.
# Si se deja vacía, DbSeeder usa el valor por defecto del código fuente, que es público.
SEED_ADMIN_PASSWORD=
