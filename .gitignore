# Visual Studio
.vs/
*.user
*.suo
*.tmp
*.log

# Build results
bin/
obj/
*.dll
*.pdb
*.cache


# Publicación y perfiles locales
Properties/PublishProfiles/
*.pubxml
*.publishproj

# Archivos absolutos generados por Visual Studio
*.FileListAbsolute.txt
.claude/

# Avatares subidos por los usuarios: son datos de runtime, no del repo.
# Se ignora el contenido pero se conserva la carpeta (.gitkeep) para que
# exista en el deploy sin necesidad de crearla a mano.
catalogo-web-mvc/wwwroot/uploads/avatars/*
!catalogo-web-mvc/wwwroot/uploads/avatars/.gitkeep

# Variables de entorno con credenciales (ver .env.example)
.env
.env.*
!.env.example

# Resultado de compilar el front: lo genera npm run build a partir de
# catalogo-front, y la imagen de Docker lo rehace en cada construccion. Lo que
# se puede regenerar no se versiona, y ademas versionarlo permitiria desplegar
# un front viejo por haber olvidado compilar.
catalogo-web-mvc/wwwroot/app/
