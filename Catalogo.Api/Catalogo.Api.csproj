<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>catalogo_web_mvc</RootNamespace>
    <!-- Mismo identificador que el MVC: las dos aplicaciones son el mismo sistema
         contra la misma base, y compartir los secretos evita duplicar la cadena de
         conexion en la maquina de desarrollo. -->
    <UserSecretsId>b1cc3b04-d3e0-4a5b-824a-d176f74fca4c</UserSecretsId>
  </PropertyGroup>

  <!-- Este proyecto quedó como host: arranca el proceso, configura autenticación y DI,
       y aloja los controladores que viven en Catalogo.Endpoints. -->
  <ItemGroup>
    <ProjectReference Include="..\Catalogo.Datos\Catalogo.Datos.csproj" />
    <ProjectReference Include="..\Catalogo.Endpoints\Catalogo.Endpoints.csproj" />
  </ItemGroup>

</Project>
